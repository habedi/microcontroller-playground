# Python specific
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env/
env/
.venv/
venv/

# Packaging and distribution files
.Python
build/

# ESP-IDF fetches managed components into each project directory, and the path
# is not configurable. The pin is dependencies.lock, which is committed, so the
# fetched source stays out of the repository the same way the uv virtual
# environment does.
managed_components/

# NuttX builds an out-of-tree application where its sources live, because it is
# reached through the apps/external symlink. So object files and dependency
# lists land under experiments/ rather than under external/ like every other
# build product. The object file names embed an absolute path, which is a second
# reason they must never be committed.
experiments/**/*.o
experiments/**/Make.dep
experiments/**/.depend
experiments/**/.built

# Personal working notes
*.local.md
dist/
*.egg-info/
*.egg
MANIFEST

# Dependency directories
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
.installed.cfg

# Test and coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.benchmarks/

# IDE specific files and directories
.idea/
*.iml
.vscode/

# Jupyter Notebook files
.ipynb_checkpoints

# Temporary files created by editors and the system and folders to ignore
*.swp
*~
*.bak
*.tmp
temp/
output/
tmp/
tmp2/
out/
out2/

# Database files (SQLite, DuckDB, etc.)
*.duckdb
*.db
*.wal
*.sqlite

# Dependency lock files (uncomment to ignore)
poetry.lock

# Documentation files
site/

# Nix build outputs and the pinned dev shell profile
result
result-*
.nix-devshell-profile*

# Miscellaneous files and directories to ignore
# Add any additional file patterns a directory names that should be ignored down here
.env
.claude/
.codex
.antigravitycli/
