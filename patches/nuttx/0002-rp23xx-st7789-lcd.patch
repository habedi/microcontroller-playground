diff --git a/boards/arm/rp23xx/common/src/rp23xx_common_bringup.c b/boards/arm/rp23xx/common/src/rp23xx_common_bringup.c
index 06fd9857..c69a3173 100644
--- a/boards/arm/rp23xx/common/src/rp23xx_common_bringup.c
+++ b/boards/arm/rp23xx/common/src/rp23xx_common_bringup.c
@@ -31,6 +31,16 @@
 
 #include <nuttx/fs/fs.h>
 
+#ifdef CONFIG_VIDEO_FB
+#  include <nuttx/video/fb.h>
+#endif
+#ifdef CONFIG_LCD
+#  include <nuttx/lcd/lcd.h>
+#endif
+#ifdef CONFIG_LCD_DEV
+#  include <nuttx/lcd/lcd_dev.h>
+#endif
+
 #include <arch/board/board.h>
 
 #include "rp23xx_common_pico.h"
@@ -598,5 +608,32 @@ int rp23xx_common_bringup(void)
     }
 
 #endif
+
+#ifdef CONFIG_VIDEO_FB
+  /* The framebuffer layer calls board_lcd_initialize() and
+   * board_lcd_getdev() for us when CONFIG_LCD_FRAMEBUFFER is set.
+   */
+
+  ret = fb_register(0, 0);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: fb_register() failed: %d\n", ret);
+    }
+#elif defined(CONFIG_LCD)
+  ret = board_lcd_initialize();
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: board_lcd_initialize() failed: %d\n", ret);
+    }
+#endif
+
+#ifdef CONFIG_LCD_DEV
+  ret = lcddev_register(0);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: lcddev_register() failed: %d\n", ret);
+    }
+#endif
+
   return ret;
 }
diff --git a/boards/arm/rp23xx/common/src/rp23xx_st7789.c b/boards/arm/rp23xx/common/src/rp23xx_st7789.c
