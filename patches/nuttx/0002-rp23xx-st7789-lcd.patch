--- /dev/null
+++ b/boards/arm/rp23xx/common/src/rp23xx_st7789.c
@@ -0,0 +1,201 @@
+/****************************************************************************
+ * boards/arm/rp23xx/common/src/rp23xx_st7789.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
